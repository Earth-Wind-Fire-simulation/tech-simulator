                    <chunk name="param_input" index="1">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">"Model" if you are working in 3d or "Plan" if you are working in 2d.

(Default is "Model") (Optional)</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">1b2f4803-af6e-4777-b51c-e884fa5e4b33</item>
                        <item name="Name" type_name="gh_string" type_code="10">Context Type</item>
